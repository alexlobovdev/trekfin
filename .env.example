APP_NAME=Trekfin
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://trekfin.ru
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Yekaterinburg
DOMAIN=trekfin.ru
EDGE_NETWORK=crm
ACME_EMAIL=admin@trekfin.ru
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=trekfin
DB_USERNAME=trekfin
DB_PASSWORD=replace-with-a-long-random-password
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_COOKIE=trekfin_session
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
